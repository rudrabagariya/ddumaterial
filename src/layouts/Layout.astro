---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import FolderContextMenu from '../components/FolderContextMenu.astro';
import Footer from '../components/Footer.astro';
import { isFallbackMode } from '../lib/files';

interface Props {
	title: string;
}

const { title } = Astro.props;
const fallback = isFallbackMode();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<script>
			// Prevent flash of incorrect theme
			const theme = localStorage.getItem('theme');
			if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.setAttribute('data-theme', 'dark');
			}
		</script>
		<meta name="description" content="DDU MATERIAL — Free study resources for Dharmsinh Desai University students. Access notes, previous year questions, lab manuals, syllabus, and more. Organized by semester and subject." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | DDU MATERIAL</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="app-layout">
		<Sidebar />
		<div class="main-wrapper">
			<Header />
			{fallback && (
				<div style="background: linear-gradient(90deg, #f4b400, #e37400); color: #000; padding: 0.6rem 1.2rem; text-align: center; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.3px;">
					⚡ Running in limited mode due to high traffic — Login, starred & comments are temporarily unavailable. All files are accessible!
				</div>
			)}
			<main class="main-content">
				<slot />
				<Footer />
			</main>
		</div>

		<FolderContextMenu />

		{Astro.locals.user && (
			<script>
				// Ping the server every 30 seconds to show as "Live" on the admin dashboard
				setInterval(() => {
					fetch('/api/ping', { method: 'POST' }).catch(() => {});
				}, 30000);
				
				// Also send a ping immediately on page load
				fetch('/api/ping', { method: 'POST' }).catch(() => {});
			</script>
		)}

	</body>
</html>
