---
// src/components/WelcomePopup.astro
---
<div id="welcome-modal-overlay" class="modal-overlay hidden">
  <div class="modal-content glass-panel">
    <div class="modal-header">
      <h2 style="margin: 0; font-size: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <span>🎉</span> Welcome to DDU MATERIAL!
      </h2>
      <button id="close-modal-x" class="close-btn" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <p style="margin-bottom: 1.5rem; color: var(--text-secondary); line-height: 1.5;">
        Your one-stop destination for engineering study materials! Here's a quick guide to getting the most out of the platform:
      </p>
      
      <div class="feature-list" style="max-height: 400px; overflow-y: auto; padding-right: 0.5rem;">
        <div class="feature-item">
          <div class="feature-icon" style="background: #e8f0fe; color: #1967d2;">📚</div>
          <div class="feature-text">
            <strong>Find Everything You Need</strong>
            <p>Access high-quality Notes, Previous Year Questions (PYQs), Lab Manuals, Assignments, and more, organized by semester and subject.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon" style="background: #e6f4ea; color: #137333;">📦</div>
          <div class="feature-text">
            <strong>Download Folders & Files</strong>
            <p><strong>Right-click</strong> (or <strong>long-press</strong> on your phone) on any subject folder to download all the PDFs inside it as a single ZIP file!</p>
          </div>
        </div>
        
        <div class="feature-item">
          <div class="feature-icon" style="background: #fce8e6; color: #d93025;">🖥️</div>
          <div class="feature-text">
            <strong>Immersive Full-Screen PDF Viewer</strong>
            <p>Click any file to open our custom PDF viewer. You can enter Full-Screen mode for a distraction-free study session.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon" style="background: #fef7e0; color: #f29900;">💬</div>
          <div class="feature-text">
            <strong>Discuss in Comments</strong>
            <p>Stuck on a PYQ? Every file has a dedicated comments section where you can ask questions and discuss with your batchmates.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon" style="background: #f3e8fd; color: #9334e6;">🤝</div>
          <div class="feature-text">
            <strong>Contribute & Feedback</strong>
            <p>Help the community by submitting your own notes via the Contribute tab. Don't forget to leave us feedback!</p>
          </div>
        </div>
      </div>
      
      <div class="modal-footer">
        <label class="checkbox-label" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--text-muted); font-size: 0.9rem;">
          <input type="checkbox" id="dont-show-again" style="accent-color: var(--accent-primary); width: 1.1rem; height: 1.1rem;">
          Don't show this again
        </label>
        <button id="start-studying-btn" class="btn btn-primary" style="padding: 0.6rem 1.5rem; font-size: 1rem;">Got it, let's study!</button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .modal-content {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 550px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
    transform: translateY(0) scale(1);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .modal-overlay.hidden .modal-content {
    transform: translateY(20px) scale(0.95);
  }

  .modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: var(--text-primary);
  }

  .modal-body {
    padding: 1.5rem;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .feature-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .feature-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .feature-text > strong {
    display: block;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    font-size: 1.05rem;
  }

  .feature-text p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .modal-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  @media (max-width: 480px) {
    .modal-footer {
      flex-direction: column;
      gap: 1rem;
    }
    .modal-footer button {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('welcome-modal-overlay');
    const closeBtnX = document.getElementById('close-modal-x');
    const startBtn = document.getElementById('start-studying-btn');
    const dontShowCheckbox = document.getElementById('dont-show-again') as HTMLInputElement;

    if (!modal) return;

    // Check localStorage (permanent) and sessionStorage (current session)
    const hasSeenWelcome = localStorage.getItem('hideWelcome') === 'true';
    const hasDismissedThisSession = sessionStorage.getItem('sessionHideWelcome') === 'true';
    
    if (!hasSeenWelcome && !hasDismissedThisSession) {
      // Small delay for smooth entrance animation
      setTimeout(() => {
        modal.classList.remove('hidden');
      }, 100);
    }

    const closeModal = () => {
      modal.classList.add('hidden');
      // Always dismiss for the current session
      sessionStorage.setItem('sessionHideWelcome', 'true');
      
      // Permanently dismiss if checkbox is checked
      if (dontShowCheckbox && dontShowCheckbox.checked) {
        localStorage.setItem('hideWelcome', 'true');
      }
    };

    if (closeBtnX) closeBtnX.addEventListener('click', closeModal);
    if (startBtn) startBtn.addEventListener('click', closeModal);
    
    // Optional: close on background click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  });
</script>
