---
const user = Astro.locals.user;
const defaultAvatar = user ? `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=4285f4&color=fff&size=128` : '';
const avatar = user?.avatarUrl || defaultAvatar;
const currentSem = Astro.url.searchParams.get('sem') || 'all';
---
<header class="site-header">
  <div class="header-content">
    <div class="flex items-center gap-3" style="flex: 1; max-width: 600px; margin-right: 2rem;">
      <button id="mobile-menu-btn" class="mobile-only-btn" aria-label="Toggle Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <form action="/search" method="GET" class="search-form-container" style="flex: 1;" id="search-form">
        <div class="search-wrapper" style="display: flex; gap: 0.5rem;">
          <div style="position: relative; flex: 1;">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" name="q" id="search-input-field" class="search-input" placeholder="Search..." aria-label="Search resources" required autocomplete="off">
          </div>
          <button type="submit" class="btn btn-primary mobile-hidden" style="padding: 0.5rem 1rem;">Go</button>
        </div>
        
        <!-- Expandable Tray -->
        <div id="search-filters-tray" class="search-filters-tray">
          <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 500;">Filter by Semester:</div>
          <div class="filter-pills">
            <label class="filter-pill-label">
              <input type="radio" name="sem" value="all" checked={currentSem === 'all'}>
              <span class="filter-pill">All</span>
            </label>
            <label class="filter-pill-label">
              <input type="radio" name="sem" value="sem1" checked={currentSem === 'sem1'}>
              <span class="filter-pill">Sem 1</span>
            </label>
            <label class="filter-pill-label">
              <input type="radio" name="sem" value="sem2" checked={currentSem === 'sem2'}>
              <span class="filter-pill">Sem 2</span>
            </label>
            <label class="filter-pill-label">
              <input type="radio" name="sem" value="sem3" checked={currentSem === 'sem3'}>
              <span class="filter-pill">Sem 3</span>
            </label>
            <label class="filter-pill-label">
              <input type="radio" name="sem" value="sem4" checked={currentSem === 'sem4'}>
              <span class="filter-pill">Sem 4</span>
            </label>
            <label class="filter-pill-label">
              <input type="radio" name="sem" value="sem5" checked={currentSem === 'sem5'}>
              <span class="filter-pill">Sem 5</span>
            </label>
            <label class="filter-pill-label">
              <input type="radio" name="sem" value="sem6" checked={currentSem === 'sem6'}>
              <span class="filter-pill">Sem 6</span>
            </label>
            <label class="filter-pill-label">
              <input type="radio" name="sem" value="sem7" checked={currentSem === 'sem7'}>
              <span class="filter-pill">Sem 7</span>
            </label>
          </div>
        </div>
      </form>
    </div>
    <div class="flex items-center gap-4">
      <button id="theme-toggle" class="btn btn-outline" style="padding: 0.25rem 0.5rem; border: none; font-size: 1.25rem; cursor: pointer;" aria-label="Toggle Dark Mode">
        <span id="theme-icon">🌙</span>
      </button>
      
      {user ? (
        <div class="flex items-center gap-3">
          <img src={avatar} alt={user.name} style="width: 32px; height: 32px; border-radius: 50%;" onerror={`this.onerror=null;this.src='${defaultAvatar}'`} />
          <form method="POST" action="/api/auth/logout">
            <button class="btn btn-outline" style="padding: 0.25rem 0.75rem; font-size: 0.8rem;">Logout</button>
          </form>
        </div>
      ) : (
        <a href="/api/auth/google" class="btn btn-primary" style="padding: 0.4rem 1rem; font-size: 0.9rem;">Login</a>
      )}
    </div>
  </div>
</header>

<script>
  // Search Tray Logic
  const searchInput = document.getElementById('search-input-field');
  const searchTray = document.getElementById('search-filters-tray');
  const searchForm = document.getElementById('search-form');

  if (searchInput && searchTray && searchForm) {
    searchInput.addEventListener('focus', () => {
      searchTray.classList.add('open');
    });

    // Close when clicking outside the form
    document.addEventListener('click', (e) => {
      if (!searchForm.contains(e.target as Node)) {
        searchTray.classList.remove('open');
      }
    });
  }

  // Dark Mode Logic
  const themeToggle = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-icon');

  if (themeToggle && themeIcon) {
    // Initial icon state
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    themeIcon.textContent = isDark ? '☀️' : '🌙';

    themeToggle.addEventListener('click', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const isCurrentlyDark = currentTheme === 'dark';
      
      if (isCurrentlyDark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
        themeIcon.textContent = '🌙';
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        themeIcon.textContent = '☀️';
      }
    });
  }
</script>

<style>
  .search-form-container {
    position: relative;
    /* This allows the container to naturally expand height, pushing content down */
  }

  .search-filters-tray {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    margin-top: 0;
  }

  .search-filters-tray.open {
    max-height: 200px; /* arbitrary large enough height */
    opacity: 1;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pill-label {
    cursor: pointer;
  }

  .filter-pill-label input[type="radio"] {
    display: none;
  }

  .filter-pill {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 2rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    transition: all 0.2s;
    user-select: none;
  }

  .filter-pill:hover {
    background: var(--bg-glass-hover);
  }

  .filter-pill-label input[type="radio"]:checked + .filter-pill {
    background: var(--accent-primary);
    color: white;
    border-color: var(--accent-primary);
  }

  .mobile-only-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.25rem;
  }

  @media (max-width: 768px) {
    .mobile-only-btn {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mobile-hidden {
      display: none !important;
    }
  }
</style>
