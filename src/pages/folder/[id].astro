---
import Layout from '../../layouts/Layout.astro';
import materials from '../../data/materials.json';
import AdBanner from '../../components/AdBanner.astro';
import { drizzle } from 'drizzle-orm/d1';
import { starredTable } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const { id } = Astro.params;
const user = Astro.locals.user;
const db = drizzle(env.DB as any);

let starredFileIds = new Set();
if (user) {
  const starred = await db.select({ fileId: starredTable.fileId })
    .from(starredTable)
    .where(eq(starredTable.userId, user.id))
    .all();
  starredFileIds = new Set(starred.map(s => s.fileId));
}
const allNodes = Object.values(materials).flat();
const folder = allNodes.find((n: any) => n.id === id && n.type === 'folder');

if (!folder) {
  return Astro.redirect('/404');
}

// Build breadcrumbs recursively
const buildBreadcrumbs = (folderId) => {
  const breadcrumbs = [];
  let current = allNodes.find(n => n.id === folderId);
  while (current && current.parent !== 'root') {
    breadcrumbs.unshift(current);
    current = allNodes.find(n => n.id === current.parent);
  }
  if (current && current.parent === 'root') {
    breadcrumbs.unshift(current);
  }
  return breadcrumbs;
};

const breadcrumbs = buildBreadcrumbs(folder.id);
const children = allNodes.filter(n => n.parent === folder.id);
const childFolders = children.filter(n => n.type === 'folder').sort((a: any, b: any) => a.name.localeCompare(b.name, undefined, {numeric: true, sensitivity: 'base'}));
const childFiles = children.filter(n => n.type === 'file').sort((a: any, b: any) => a.name.localeCompare(b.name, undefined, {numeric: true, sensitivity: 'base'}));

// Helper to convert Google Drive view URLs into Direct Download URLs
const getDownloadUrl = (url) => {
  const match = url.match(/file\/d\/([a-zA-Z0-9_-]+)/);
  return match ? `https://drive.google.com/uc?export=download&id=${match[1]}` : url;
};
---

<Layout title={folder.name}>
  <div class="container">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm" style="color: var(--text-muted);">
        <ol class="flex items-center gap-2 flex-wrap">
          <li>
            <a href="/" style="color: var(--text-muted); text-decoration: none;" class="hover:text-white">Home</a>
          </li>
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center gap-2">
              <span>/</span>
              {index === breadcrumbs.length - 1 ? (
                <span class="font-medium" style="color: white;">{crumb.name}</span>
              ) : (
                <a href={`/folder/${crumb.id}`} style="color: var(--text-muted); text-decoration: none;" class="hover:text-white">{crumb.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="flex items-center gap-4 justify-between">
        <h1 class="h1 text-gradient" style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
          📁 {folder.name}
        </h1>
        {childFiles.length > 0 && (
          <button id="download-zip-btn" class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem; white-space: nowrap;" data-folder-name={folder.name} data-files={JSON.stringify(childFiles.map(f => ({ id: f.id, name: f.name })))}>
            <span id="zip-icon">📦</span>
            <span id="zip-text">Download Folder as ZIP</span>
          </button>
        )}
      </div>
    </div>

    {childFolders.length > 0 && (
      <div class="mb-6">
        <div class="grid grid-cols-4">
          {childFolders.map(cf => (
            <a href={`/folder/${cf.id}`} class="glass-panel hover-card block" style="padding: 0.75rem 1rem; text-decoration: none;">
              <div class="flex items-center gap-3">
                <span style="font-size: 1.25rem;">📁</span>
                <h3 class="card-title" style="font-size: 0.95rem; margin: 0; color: var(--text-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{cf.name}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {childFiles.length > 0 && (
      <div class="grid grid-cols-3" style="align-items: start;">
        {childFiles.map(res => {
          const isStarred = starredFileIds.has(res.id);
          return (
          <div class="glass-panel" style="display: flex; flex-direction: column; overflow: hidden;">
            <a href={`/view/${res.id}`} style="display: block; height: 160px; background-color: #f1f3f4; border-bottom: 1px solid var(--border-color); display: flex; justify-content: center; align-items: center; overflow: hidden; text-decoration: none;">
               <img src={`https://drive.google.com/thumbnail?id=${res.id}&sz=w400-h400`} alt="Preview" loading="lazy" referrerpolicy="no-referrer" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';" />
               <span style="display: none; font-size: 3rem;">📄</span>
            </a>
            
            <div style="padding: 1rem; display: flex; flex-direction: column; flex: 1; gap: 0.75rem;">
              <div class="flex items-start justify-between gap-2">
                <div style="min-width: 0; flex: 1;">
                  <h3 class="card-title" style="font-size: 1rem; margin-bottom: 0.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={res.name}>{res.name}</h3>
                  <span style="color: var(--text-muted); font-size: 0.8rem;">{res.size}</span>
                </div>
                {user && (
                  <form method="POST" action="/api/star" class="star-form">
                    <input type="hidden" name="fileId" value={res.id} />
                    <input type="hidden" name="redirect" value={`/folder/${id}`} />
                    <button type="submit" style="background: none; border: none; cursor: pointer; color: #f4b400; padding: 0.25rem;">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill={isStarred ? "#f4b400" : "none"} stroke="#f4b400" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                    </button>
                  </form>
                )}
              </div>
              <div class="flex gap-2 mt-auto">
                <a href={getDownloadUrl(res.url)} target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="flex: 1; padding: 0.4rem; font-size: 0.85rem;">Download</a>
              </div>
            </div>
          </div>
        )})}
      </div>
    )}

    {childFolders.length === 0 && childFiles.length === 0 && (
      <div class="glass-panel text-center" style="padding: 3rem;">
        <p style="color: var(--text-muted); font-size: 1.1rem;">This folder is empty.</p>
      </div>
    )}

    {/* AdSense Ad Banner */}
    <AdBanner className="mt-8 mb-4" />
  </div>

  <script>
    import JSZip from 'jszip';
    import { saveAs } from 'file-saver';

    const btn = document.getElementById('download-zip-btn');
    if (btn) {
      btn.addEventListener('click', async () => {
        const folderName = btn.getAttribute('data-folder-name') || 'folder';
        const files = JSON.parse(btn.getAttribute('data-files') || '[]');
        
        if (files.length === 0) return;

        const icon = document.getElementById('zip-icon');
        const text = document.getElementById('zip-text');
        
        // Update UI to loading state
        btn.style.opacity = '0.7';
        btn.style.pointerEvents = 'none';
        if (icon) icon.textContent = '⏳';
        if (text) text.textContent = `Zipping ${files.length} files...`;

        try {
          const zip = new JSZip();

          // Fetch all files in parallel via our proxy
          await Promise.all(files.map(async (file: any) => {
            const res = await fetch(`/api/proxy?id=${file.id}`);
            if (!res.ok) throw new Error(`Failed to fetch ${file.name}`);
            const blob = await res.blob();
            // Append .pdf if missing so files are easily readable
            const fileName = file.name.endsWith('.pdf') ? file.name : `${file.name}.pdf`;
            zip.file(fileName, blob);
          }));

          // Generate and save ZIP
          if (text) text.textContent = 'Saving...';
          const zipContent = await zip.generateAsync({ type: 'blob' });
          saveAs(zipContent, `${folderName}.zip`);

        } catch (error) {
          console.error("ZIP Error:", error);
          alert("Failed to create ZIP. Some files might be too large or unavailable.");
        } finally {
          // Reset UI
          btn.style.opacity = '1';
          btn.style.pointerEvents = 'auto';
          if (icon) icon.textContent = '📦';
          if (text) text.textContent = 'Download Folder as ZIP';
        }
      });
    }
  </script>
</Layout>
