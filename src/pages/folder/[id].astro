---
import Layout from '../../layouts/Layout.astro';
import { getNodeById, getChildren, buildBreadcrumbs, getAllChildFiles, isFallbackMode } from '../../lib/files';
import { drizzle } from 'drizzle-orm/d1';
import { starredTable } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const { id } = Astro.params;
const user = Astro.locals.user;
const db = drizzle(env.DB as any);

let starredFileIds = new Set();
if (user) {
  try {
    const starred = await db.select({ fileId: starredTable.fileId })
      .from(starredTable)
      .where(eq(starredTable.userId, user.id))
      .all();
    starredFileIds = new Set(starred.map(s => s.fileId));
  } catch { /* D1 unavailable, skip starred */ }
}

const folder = await getNodeById(env.DB as any, id!);

if (!folder || folder.type !== 'folder') {
  return Astro.redirect('/404');
}

const breadcrumbs = await buildBreadcrumbs(env.DB as any, folder.id);
const children = await getChildren(env.DB as any, folder.id);
const childFolders = children.filter(n => n.type === 'folder');
const childFiles = children.filter(n => n.type === 'file');

// Helper to get all child files for ZIP download
const getChildFilesForZip = async (folderId: string) => {
  return await getAllChildFiles(env.DB as any, folderId);
};

// Now that all heavy queries (getChildren, etc) have run and potentially triggered fallback mode, we check auth
if (!user && !isFallbackMode()) {
  return Astro.redirect('/');
}

// Pre-fetch child files for each folder (for context menu ZIP)
const folderChildFiles: Record<string, { id: string; name: string }[]> = {};
for (const cf of childFolders) {
  folderChildFiles[cf.id] = await getChildFilesForZip(cf.id);
}

// Helper to convert Google Drive view URLs into Direct Download URLs
const getDownloadUrl = (url) => {
  const match = url?.match(/file\/d\/([a-zA-Z0-9_-]+)/);
  return match ? `https://drive.google.com/uc?export=download&id=${match[1]}` : url;
};
---

<Layout title={folder.name}>
  <div class="container">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm" style="color: var(--text-muted);">
        <ol class="flex items-center gap-2 flex-wrap">
          <li>
            <a href="/" style="color: var(--text-muted); text-decoration: none;" class="hover:text-white">Home</a>
          </li>
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center gap-2">
              <span>/</span>
              {index === breadcrumbs.length - 1 ? (
                <span class="font-medium" style="color: white;">{crumb.name}</span>
              ) : (
                <a href={`/folder/${crumb.id}`} style="color: var(--text-muted); text-decoration: none;" class="hover:text-white">{crumb.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="flex items-center gap-4 justify-between">
        <h1 class="h1 text-gradient" style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
          📁 {folder.name}
        </h1>
      </div>
    </div>

    {childFolders.length > 0 && (
      <div class="mb-6">
        <div class="grid grid-cols-4">
          {childFolders.map(cf => (
            <a href={`/folder/${cf.id}`} class="glass-panel hover-card block context-folder" data-folder-name={cf.name} data-files={JSON.stringify(folderChildFiles[cf.id] || [])} style="padding: 0.75rem 1rem; text-decoration: none;">
              <div class="flex items-center gap-3">
                <span style="font-size: 1.25rem;">📁</span>
                <h3 class="card-title" style="font-size: 0.95rem; margin: 0; color: var(--text-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{cf.name}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {childFiles.length > 0 && (
      <div class="grid grid-cols-3" style="align-items: start;">
        {childFiles.map(res => {
          const isStarred = starredFileIds.has(res.id);
          return (
          <div class="glass-panel" style="display: flex; flex-direction: column; overflow: hidden;">
            <a href={`/view/${res.id}`} style="display: block; height: 160px; background-color: #f1f3f4; border-bottom: 1px solid var(--border-color); display: flex; justify-content: center; align-items: center; overflow: hidden; text-decoration: none;">
               <img src={`https://drive.google.com/thumbnail?id=${res.id}&sz=w400-h400`} alt="Preview" loading="lazy" referrerpolicy="no-referrer" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';" />
               <span style="display: none; font-size: 3rem;">📄</span>
            </a>
            
            <div style="padding: 1rem; display: flex; flex-direction: column; flex: 1; gap: 0.75rem;">
              <div class="flex items-start justify-between gap-2">
                <div style="min-width: 0; flex: 1;">
                  <h3 class="card-title" style="font-size: 1rem; margin-bottom: 0.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; gap: 0.4rem;" title={res.name}>
                    {res.name}
                  </h3>
                  <span style="color: var(--text-muted); font-size: 0.8rem;">{res.size}</span>
                </div>
                {user && (
                  <form method="POST" action="/api/star" class="star-form">
                    <input type="hidden" name="fileId" value={res.id} />
                    <input type="hidden" name="redirect" value={`/folder/${id}`} />
                    <button type="submit" style="background: none; border: none; cursor: pointer; color: #f4b400; padding: 0.25rem;">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill={isStarred ? "#f4b400" : "none"} stroke="#f4b400" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                    </button>
                  </form>
                )}
              </div>
              <div class="flex gap-2 mt-auto">
                <a href={getDownloadUrl(res.url)} target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="flex: 1; padding: 0.4rem; font-size: 0.85rem;">Download</a>
              </div>
            </div>
          </div>
        )})}
      </div>
    )}

    {childFolders.length === 0 && childFiles.length === 0 && (
      <div class="glass-panel text-center" style="padding: 3rem;">
        <p style="color: var(--text-muted); font-size: 1.1rem;">This folder is empty.</p>
      </div>
    )}

    {/* AdSense Ad Banner */}
  </div>
</Layout>
