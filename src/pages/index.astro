---
import Layout from '../layouts/Layout.astro';
import { getRootFolders, getNodeById, isFallbackMode } from '../lib/files';
import { drizzle } from 'drizzle-orm/d1';
import { recentlyViewedTable } from '../db/schema';
import { desc, eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
const db = drizzle(env.DB as any);

// Data loading (these might fail and trigger fallback mode)
const rootFolders = await getRootFolders(env.DB as any);

// Capture fallback state AFTER data loading has attempted
const fallback = isFallbackMode();

let recentFiles: any[] = [];
if (user) {
  try {
    const history = await db.select()
      .from(recentlyViewedTable)
      .where(eq(recentlyViewedTable.userId, user.id))
      .orderBy(desc(recentlyViewedTable.viewedAt))
      .limit(4)
      .all();
      
    const files = await Promise.all(
      history.map(h => getNodeById(env.DB as any, h.fileId))
    );
    recentFiles = files.filter(Boolean);
  } catch { /* D1 unavailable, skip recently viewed */ }
}
const defaultAvatar = user ? `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=4285f4&color=fff&size=128` : '';
const avatar = user?.avatarUrl || defaultAvatar;
---

<Layout title="DDU MATERIAL - Home">
  <div class="container">
    {(user || fallback) ? (
      <>
        <div class="mb-8">
          <h2 class="h2 mb-4" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <span>📚</span> Semester Folders
          </h2>
          
          <div class="grid grid-cols-4">
            {rootFolders.map((folder: any) => (
              <a href={`/folder/${folder.id}`} class="glass-panel hover-card block" style="padding: 0.75rem 1rem; text-decoration: none;">
                <div class="flex items-center gap-3">
                  <span style="font-size: 1.25rem;">📁</span>
                  <h3 class="card-title" style="font-size: 0.95rem; margin: 0; color: var(--text-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{folder.name}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>

        {recentFiles.length > 0 && (
          <div class="mb-12">
            <h2 class="h3 mb-4" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
              <span>🕒</span> Recently Viewed
            </h2>
            <div class="grid grid-cols-2" style="align-items: start;">
              {recentFiles.map((res: any) => (
                <div class="glass-panel" style="display: flex; flex-direction: column; overflow: hidden;">
                  <a href={`/view/${res.id}`} style="display: block; height: 160px; background-color: #f1f3f4; border-bottom: 1px solid var(--border-color); display: flex; justify-content: center; align-items: center; overflow: hidden; text-decoration: none;">
                     <img src={`https://drive.google.com/thumbnail?id=${res.id}&sz=w400-h400`} alt="Preview" loading="lazy" referrerpolicy="no-referrer" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';" />
                     <span style="display: none; font-size: 3rem;">📄</span>
                  </a>
                  <div style="padding: 1rem; display: flex; flex-direction: column; flex: 1; gap: 0.75rem;">
                    <div class="flex items-start justify-between gap-2">
                      <div style="min-width: 0; flex: 1;">
                        <h3 class="card-title" style="font-size: 1rem; margin-bottom: 0.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={res.name}>{res.name}</h3>
                        <span style="color: var(--text-muted); font-size: 0.8rem;">{res.size || 'PDF Document'}</span>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </>
    ) : (
      <>
        <div class="glass-panel text-center" style="padding: 3rem 2rem; margin-top: 2rem;">
          <h1 class="h1 mb-4 text-gradient">Welcome to DDU MATERIAL</h1>
          <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8; margin-bottom: 2.5rem; max-width: 600px; margin-left: auto; margin-right: auto;">
            Your one-stop platform for all Dharmsinh Desai University study resources. Access organized notes, previous year question papers, lab manuals, and more — completely free.
          </p>
          {!fallback && (
            <a href="/api/auth/google" class="btn btn-primary" style="font-size: 1.1rem; padding: 0.8rem 2rem; display: inline-flex; align-items: center; justify-content: center;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" style="margin-right: 0.5rem;" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22.5 12.0001C22.5 11.2335 22.4333 10.5001 22.3 9.8001H12.0001V13.9001H18.0667C17.8 15.3001 16.9667 16.5001 15.7334 17.3335V19.9335H19.3334C21.4667 17.9668 22.5 15.1001 22.5 12.0001Z" fill="#4285F4"/>
                <path d="M12.0001 22.5C14.9334 22.5 17.4001 21.5333 19.3334 19.9333L15.7334 17.3333C14.7 18.0667 13.4334 18.5 12.0001 18.5C9.26673 18.5 6.96673 16.6667 6.1334 14.2H2.40006V16.9C4.30006 20.6667 8.00006 22.5 12.0001 22.5Z" fill="#34A853"/>
                <path d="M6.13333 14.2001C5.93333 13.5667 5.8 12.8667 5.8 12.1667C5.8 11.4667 5.93333 10.7667 6.13333 10.1334V7.43341H2.4C1.56667 9.06674 1.13333 10.8667 1.13333 12.1667C1.13333 13.4667 1.56667 15.2667 2.4 16.9001L6.13333 14.2001Z" fill="#FBBC05"/>
                <path d="M12.0001 5.83333C13.6001 5.83333 15.0334 6.36667 16.1667 7.43334L19.4667 4.13334C17.4 2.2 14.9334 1.13334 12.0001 1.13334C8.00006 1.13334 4.30006 3.66667 2.40006 7.43334L6.1334 10.1333C6.96673 7.66667 9.26673 5.83333 12.0001 5.83333Z" fill="#EA4335"/>
              </svg>
              Login with Google to Get Started
            </a>
          )}
        </div>

        <div style="margin-top: 2.5rem;">
          <h2 class="h2 mb-4" style="text-align: center;">📚 What You'll Find Inside</h2>
          <div class="grid grid-cols-2" style="gap: 1rem;">
            <div class="glass-panel" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">📝</div>
              <h3 style="color: var(--text-primary); font-size: 1.05rem; margin-bottom: 0.5rem;">Handwritten & Typed Notes</h3>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">High-quality notes from top-performing students across all semesters and subjects, carefully curated to help you study smarter.</p>
            </div>
            <div class="glass-panel" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">📄</div>
              <h3 style="color: var(--text-primary); font-size: 1.05rem; margin-bottom: 0.5rem;">Previous Year Questions</h3>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">Sessional and university exam papers from previous years. Practice with real questions to understand the exam pattern and boost your preparation.</p>
            </div>
            <div class="glass-panel" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">🔬</div>
              <h3 style="color: var(--text-primary); font-size: 1.05rem; margin-bottom: 0.5rem;">Lab Manuals & Practicals</h3>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">Complete lab manuals with experiment procedures, observations, and viva questions to help you prepare for practical exams.</p>
            </div>
            <div class="glass-panel" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">📖</div>
              <h3 style="color: var(--text-primary); font-size: 1.05rem; margin-bottom: 0.5rem;">Syllabus & Reference Books</h3>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">Official university syllabus documents and recommended textbook references so you always know exactly what to study.</p>
            </div>
          </div>
        </div>

        <div style="margin-top: 2.5rem;">
          <h2 class="h2 mb-4" style="text-align: center;">✨ Platform Features</h2>
          <div class="grid grid-cols-3" style="gap: 1rem;">
            <div class="glass-panel text-center" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">🔍</div>
              <h3 style="color: var(--text-primary); font-size: 0.95rem; margin-bottom: 0.4rem;">Smart Search</h3>
              <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">Search across all semesters with advanced filters to find exactly what you need.</p>
            </div>
            <div class="glass-panel text-center" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">📦</div>
              <h3 style="color: var(--text-primary); font-size: 0.95rem; margin-bottom: 0.4rem;">ZIP Downloads</h3>
              <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">Download entire folders as a single ZIP file with one click.</p>
            </div>
            <div class="glass-panel text-center" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">🖥️</div>
              <h3 style="color: var(--text-primary); font-size: 0.95rem; margin-bottom: 0.4rem;">PDF Viewer</h3>
              <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">Read documents directly in your browser with full-screen mode.</p>
            </div>
            <div class="glass-panel text-center" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">⭐</div>
              <h3 style="color: var(--text-primary); font-size: 0.95rem; margin-bottom: 0.4rem;">Star & Bookmark</h3>
              <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">Star important files to quickly access them later.</p>
            </div>
            <div class="glass-panel text-center" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">💬</div>
              <h3 style="color: var(--text-primary); font-size: 0.95rem; margin-bottom: 0.4rem;">Comments</h3>
              <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">Discuss and ask questions on any file with other students.</p>
            </div>
            <div class="glass-panel text-center" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">🌙</div>
              <h3 style="color: var(--text-primary); font-size: 0.95rem; margin-bottom: 0.4rem;">Dark Mode</h3>
              <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin: 0;">Eye-friendly OLED dark theme for late-night study sessions.</p>
            </div>
          </div>
        </div>

        <div class="glass-panel" style="margin-top: 2.5rem; padding: 2rem; text-align: center;">
          <h2 class="h3" style="color: var(--text-primary); margin-bottom: 0.75rem;">🤝 Built by Students, for Students</h2>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; max-width: 600px; margin: 0 auto 1.5rem auto;">
            DDU MATERIAL is a community-driven initiative. All study materials are contributed by fellow students and alumni. Have notes that could help others? You can contribute too!
          </p>
          <a href="/about" class="btn btn-outline" style="padding: 0.6rem 1.5rem;">Learn More</a>
        </div>
      </>
    )}

  </div>
</Layout>
