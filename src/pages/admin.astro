---
import Layout from '../layouts/Layout.astro';
import { drizzle } from 'drizzle-orm/d1';
import { searchQueriesTable, donationsTable, recentlyViewedTable, userTable, feedbackTable, filesTable } from '../db/schema';
import { desc, count, sql, eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
const adminEmail = env.ADMIN_EMAIL; 

if (!user || user.email !== adminEmail) {
  return new Response('Unauthorized - Admins Only', { status: 403 });
}

const db = drizzle(env.DB as any);

// 1. Get Top 10 Searches
const topSearches = await db.select({
  query: searchQueriesTable.query,
  count: count(searchQueriesTable.id)
})
.from(searchQueriesTable)
.groupBy(searchQueriesTable.query)
.orderBy(desc(count(searchQueriesTable.id)))
.limit(10)
.all();

// 2. Get User Engagement (Unique users in last 7 days)
const sevenDaysAgo = Date.now() - (7 * 24 * 60 * 60 * 1000);
const activeUsers = await db.select({
  count: count(sql`DISTINCT ${recentlyViewedTable.userId}`)
})
.from(recentlyViewedTable)
.where(sql`${recentlyViewedTable.viewedAt} > ${sevenDaysAgo}`)
.all();

// 3. Live Users Counter (Active in the last 2 minutes)
const twoMinutesAgo = Date.now() - (2 * 60 * 1000);
const liveUsers = await db.select({
  count: count(userTable.id)
})
.from(userTable)
.where(sql`${userTable.lastActiveAt} > ${twoMinutesAgo}`)
.all();

// 4. Registered Users Directory
const registeredUsers = await db.select({
  id: userTable.id,
  name: userTable.name,
  email: userTable.email,
  avatar: userTable.avatarUrl,
  lastActiveAt: userTable.lastActiveAt,
  views: count(recentlyViewedTable.id)
})
.from(userTable)
.leftJoin(recentlyViewedTable, eq(userTable.id, recentlyViewedTable.userId))
.groupBy(userTable.id)
.orderBy(desc(userTable.lastActiveAt))
.all();

// 4.5. Get Last Viewed File for Each User (OPTIMIZED)
const latestViews = await db.select({
  userId: recentlyViewedTable.userId,
  fileId: recentlyViewedTable.fileId,
  fileName: filesTable.name
})
.from(recentlyViewedTable)
.leftJoin(filesTable, eq(recentlyViewedTable.fileId, filesTable.id))
.orderBy(desc(recentlyViewedTable.viewedAt))
.all();

const lastViewedPerUser: Record<string, string> = {};
for (const view of latestViews) {
  if (!lastViewedPerUser[view.userId]) {
    lastViewedPerUser[view.userId] = view.fileName || 'Unknown File';
  }
}

// 5. Pending Donations
const pendingDonations = await db.select({
  id: donationsTable.id,
  materialName: donationsTable.materialName,
  driveLink: donationsTable.driveLink,
  description: donationsTable.description,
  submittedAt: donationsTable.submittedAt,
  userName: userTable.name,
  userEmail: userTable.email
})
.from(donationsTable)
.innerJoin(userTable, eq(donationsTable.userId, userTable.id))
.where(eq(donationsTable.status, 'pending'))
.orderBy(desc(donationsTable.submittedAt))
.all();

// 6. User Feedback
const userFeedback = await db.select({
  id: feedbackTable.id,
  category: feedbackTable.category,
  message: feedbackTable.message,
  status: feedbackTable.status,
  submittedAt: feedbackTable.submittedAt,
  userName: userTable.name,
  userEmail: userTable.email
})
.from(feedbackTable)
.leftJoin(userTable, eq(feedbackTable.userId, userTable.id))
.orderBy(desc(feedbackTable.submittedAt))
.limit(20)
.all();

---

<Layout title="Admin Dashboard">
  <div class="container" style="max-width: 1200px;">
    <div class="mb-8 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <span style="font-size: 2.5rem;">⚙️</span>
        <h1 class="h2" style="margin: 0;">Admin Dashboard</h1>
        <a href="/admin/files" class="btn btn-outline ml-4" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
          <span>📁</span> Manage Files
        </a>
      </div>
      <div class="flex gap-4">
        <div class="glass-panel flex items-center" style="padding: 0.5rem 1rem; background: var(--bg-primary);">
          <div style="width: 10px; height: 10px; background-color: #34a853; border-radius: 50%; margin-right: 0.5rem; animation: pulse 2s infinite;"></div>
          <span style="color: var(--text-muted); font-size: 0.9rem;">Live Now:</span>
          <span style="font-size: 1.25rem; font-weight: bold; margin-left: 0.5rem; color: #34a853;">{liveUsers[0]?.count || 0}</span>
        </div>
        <div class="glass-panel" style="padding: 0.5rem 1rem; background: var(--bg-primary);">
          <span style="color: var(--text-muted); font-size: 0.9rem;">7-Day Active Users:</span>
          <span style="font-size: 1.25rem; font-weight: bold; margin-left: 0.5rem; color: var(--text-color);">{activeUsers[0]?.count || 0}</span>
        </div>
      </div>
    </div>

    <style>
      @keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 168, 83, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(52, 168, 83, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 168, 83, 0); }
      }
    </style>

    <div class="grid grid-cols-2" style="grid-template-columns: 1fr 1fr; gap: 2rem;">
      
      {/* Search Analytics */}
      <div class="glass-panel" style="padding: 1.5rem;">
        <h2 class="h3 mb-4" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Top Search Queries</h2>
        {topSearches.length > 0 ? (
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
            {topSearches.map((s, idx) => (
              <li class="flex justify-between items-center" style="padding: 0.75rem; background: var(--bg-primary); border-radius: 8px;">
                <span class="flex items-center gap-3">
                  <span style="color: var(--text-muted); font-weight: bold;">#{idx + 1}</span>
                  <span style="font-weight: 500;">{s.query}</span>
                </span>
                <span class="badge" style="background: rgba(66, 133, 244, 0.1); color: #4285f4; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem;">
                  {s.count} searches
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p style="color: var(--text-muted);">No search data yet.</p>
        )}
      </div>

      {/* Pending Donations */}
      <div class="glass-panel" style="padding: 1.5rem;">
        <h2 class="h3 mb-4" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; display: flex; justify-content: space-between;">
          <span>Material Submissions</span>
          {pendingDonations.length > 0 && (
            <span class="badge" style="background: rgba(234, 67, 53, 0.1); color: #ea4335; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem;">{pendingDonations.length} Pending</span>
          )}
        </h2>
        
        {pendingDonations.length > 0 ? (
          <div class="flex flex-col gap-4">
            {pendingDonations.map(donation => (
              <div style="background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
                <div class="flex justify-between items-start mb-2">
                  <h4 style="margin: 0; font-size: 1.1rem;">{donation.materialName}</h4>
                  <span style="font-size: 0.8rem; color: var(--text-muted);">{new Date(donation.submittedAt).toLocaleDateString()}</span>
                </div>
                <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem;">Submitted by: {donation.userEmail}</p>
                {donation.description && (
                  <p style="font-size: 0.9rem; background: rgba(0,0,0,0.05); padding: 0.5rem; border-radius: 4px; margin-bottom: 1rem;">{donation.description}</p>
                )}
                <div class="flex gap-2">
                  <a href={donation.driveLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="flex: 1; padding: 0.5rem; font-size: 0.9rem; text-align: center;">View Drive Link</a>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p style="color: var(--text-muted); text-align: center; padding: 2rem 0;">No pending submissions to review! 🎉</p>
        )}
      </div>

    </div>

    {/* Registered Users Directory */}
    <div class="mt-8 glass-panel" style="padding: 1.5rem;">
      <h2 class="h3 mb-4" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; display: flex; justify-content: space-between;">
        <span>Registered Users</span>
        <span class="badge" style="background: rgba(66, 133, 244, 0.1); color: #4285f4; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem;">{registeredUsers.length} Total</span>
      </h2>
      
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.9rem;">
              <th style="padding: 0.75rem 0.5rem; font-weight: 500;">User</th>
              <th style="padding: 0.75rem 0.5rem; font-weight: 500;">Email</th>
              <th style="padding: 0.75rem 0.5rem; font-weight: 500;">Files Viewed</th>
              <th style="padding: 0.75rem 0.5rem; font-weight: 500;">Last Viewed File</th>
              <th style="padding: 0.75rem 0.5rem; font-weight: 500;">Status</th>
            </tr>
          </thead>
          <tbody>
            {registeredUsers.map(u => {
              const isActive = u.lastActiveAt && (Date.now() - u.lastActiveAt) < (2 * 60 * 1000);
              const lastFile = lastViewedPerUser[u.id];
              return (
                <tr style="border-bottom: 1px solid var(--border-color); transition: background-color 0.2s;">
                  <td style="padding: 0.75rem 0.5rem;">
                    <div class="flex items-center gap-3">
                      {u.avatar ? (
                        <img src={u.avatar} style="width: 32px; height: 32px; border-radius: 50%;" />
                      ) : (
                        <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--border-color); display: flex; align-items: center; justify-content: center;">👤</div>
                      )}
                      <span style="font-weight: 500;">{u.name}</span>
                    </div>
                  </td>
                  <td style="padding: 0.75rem 0.5rem; color: var(--text-muted);">{u.email}</td>
                  <td style="padding: 0.75rem 0.5rem;">
                    <span class="badge" style="background: var(--bg-primary); padding: 0.25rem 0.5rem; border-radius: 4px;">{u.views}</span>
                  </td>
                  <td style="padding: 0.75rem 0.5rem; color: var(--text-muted); max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={lastFile || ''}>
                    {lastFile ? lastFile : '-'}
                  </td>
                  <td style="padding: 0.75rem 0.5rem;">
                    {isActive ? (
                      <span style="color: #34a853; font-weight: 600; font-size: 0.9rem; display: flex; items-center; gap: 0.25rem;">
                        <span style="display: inline-block; width: 8px; height: 8px; background-color: #34a853; border-radius: 50%; align-self: center;"></span>
                        Online
                      </span>
                    ) : (
                      <span style="color: var(--text-muted); font-size: 0.85rem;">
                        {u.lastActiveAt ? new Date(u.lastActiveAt).toLocaleString() : 'Never'}
                      </span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    {/* User Feedback */}
    <div class="mt-8 glass-panel" style="padding: 1.5rem;">
      <h2 class="h3 mb-4" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; display: flex; justify-content: space-between;">
        <span>User Feedback & Requests</span>
        {userFeedback.length > 0 && (
          <span class="badge" style="background: rgba(147, 52, 230, 0.1); color: #9334e6; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem;">{userFeedback.length} Items</span>
        )}
      </h2>
      
      {userFeedback.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {userFeedback.map(fb => (
            <div style="background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
              <div class="flex justify-between items-start">
                <span class="badge" style={`
                  padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; text-transform: uppercase; font-weight: bold;
                  ${fb.category === 'bug' ? 'background: rgba(234, 67, 53, 0.1); color: #ea4335;' : 
                    fb.category === 'request' ? 'background: rgba(66, 133, 244, 0.1); color: #4285f4;' : 
                    'background: rgba(52, 168, 83, 0.1); color: #34a853;'}
                `}>
                  {fb.category}
                </span>
                <span style="font-size: 0.75rem; color: var(--text-muted);">{new Date(fb.submittedAt).toLocaleDateString()}</span>
              </div>
              <p style="margin: 0; font-size: 0.95rem; line-height: 1.5; flex-grow: 1;">{fb.message}</p>
              <div style="font-size: 0.8rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 0.5rem; margin-top: 0.5rem;">
                From: {fb.userEmail || 'Anonymous'}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p style="color: var(--text-muted); text-align: center; padding: 2rem 0;">No feedback received yet.</p>
      )}
    </div>
  </div>
</Layout>
