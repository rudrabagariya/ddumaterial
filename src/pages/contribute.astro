---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';

// Note: You can paste your actual Google Form link here
const GOOGLE_FORM_LINK = "https://forms.gle/YOUR_FORM_LINK_HERE";

---

<Layout title="Contribute Materials">
  <div class="container" style="max-width: 800px; padding: 2rem 1rem;">
    <div class="glass-panel" style="padding: 2rem; text-align: center;">
      <span style="font-size: 3rem; display: block; margin-bottom: 1rem;">📤</span>
      <h1 class="h2 text-gradient">Contribute Study Material</h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6; margin-bottom: 2rem;">
        Have some great notes, PYQs, or syllabus files? Help out your fellow juniors and batchmates by contributing them to DDU MATERIAL! 
      </p>

      <a href={GOOGLE_FORM_LINK} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="display: inline-block; padding: 1rem 2rem; font-size: 1.1rem;">
        Open Contribution Form
      </a>
      
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 1rem;">
        This will open a Google Form in a new tab.
      </p>
    </div>
    
    <div class="mt-8">
      <AdBanner />
    </div>
  </div>
</Layout>
